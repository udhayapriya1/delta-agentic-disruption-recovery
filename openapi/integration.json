  "components": {
    "schemas": {
      "Approval": {
        "properties": {
          "voucher_request_id": {
            "type": "string",
            "title": "Voucher Request Id"
          }
        },
        "type": "object",
        "required": [
          "voucher_request_id"
        ],
        "title": "Approval"
      },
      "Escalation": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "Escalation"
      },
      "Fault": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "normal",
              "conflict",
              "timeout",
              "unavailable"
            ],
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "Fault"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Rebook": {
        "properties": {
          "pnr": {
            "type": "string",
            "pattern": "^D\\d{5}$",
            "title": "Pnr"
          },
          "option_id": {
            "type": "string",
            "pattern": "^OPT-[12]$",
            "title": "Option Id"
          },
          "passenger_ref": {
            "type": "string",
            "pattern": "^P\\d{3}$",
            "title": "Passenger Ref"
          },
          "acceptance_id": {
            "type": "string",
            "title": "Acceptance Id"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "pnr",
          "option_id",
          "passenger_ref",
          "acceptance_id",
          "idempotency_key"
        ],
        "title": "Rebook"
      },
      "Selection": {
        "properties": {
          "pnr": {
            "type": "string",
            "pattern": "^D\\d{5}$",
            "title": "Pnr"
          },
          "option_id": {
            "type": "string",
            "pattern": "^OPT-[12]$",
            "title": "Option Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "pnr",
          "option_id"
        ],
        "title": "Selection"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Voucher": {
        "properties": {
          "passenger_ref": {
            "type": "string",
            "pattern": "^P\\d{3}$",
            "title": "Passenger Ref"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 5000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "reason": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Reason"
          },
          "case_ref": {
            "type": "string",
            "title": "Case Ref"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Idempotency Key"
          },
          "approval_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "passenger_ref",
          "amount",
          "reason",
          "case_ref",
          "idempotency_key"
        ],
        "title": "Voucher"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
